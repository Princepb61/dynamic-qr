rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Links collection: Public read and write for dynamic short links and QR assignment
    match /links/{linkId} {
      allow read: if true;
      allow write: if true;
    }

    // Clicks analytics collection: Scan telemetry
    match /clicks/{clickId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Deleted links tombstones: Cross-device deletion sync
    match /deleted_links/{slug} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
